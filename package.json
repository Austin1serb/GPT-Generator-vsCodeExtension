{
  "name": "gpt-code-generator",
  "displayName": "GPT Code Generator",
  "publisher": "SerbByteDevelopment",
  "description": "Generate code in VS Code from comments, prompts, and selected text using the OpenAI API.",
  "icon": "icon.jpg",
  "version": "1.0.2",
  "license": "MIT",
  "author": {
    "name": "Austin Serb",
    "url": "https://www.serbyte.net/"
  },
  "homepage": "https://www.serbyte.net/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Austin1serb/GPT-Generator-vsCodeExtension.git"
  },
  "bugs": {
    "url": "https://github.com/Austin1serb/GPT-Generator-vsCodeExtension/issues",
    "email": "info@serbyte.net"
  },
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "keywords": [
    "gpt",
    "openai",
    "ai",
    "code generation",
    "code generator",
    "developer tools",
    "vscode",
    "visual studio code",
    "productivity",
    "automation"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.generateWithGPT",
        "title": "Generate with GPT"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "GPT Code Generator",
      "properties": {
        "gptCodeGenerator.apiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key used to generate code."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "extension.generateWithGPT",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.2.5",
    "@types/vscode": "^1.107.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^16.3.1"
  }
}
